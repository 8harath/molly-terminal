# Discord auth (optional, not required for public clients)
# MOLLY_DISCORD_CLIENT_SECRET=your-discord-client-secret-here
# MOLLY_DISCORD_CLIENT_ID=your-discord-client-id

# Server endpoints
# MOLLY_WEBSOCKET_URL=ws://localhost:8080/ws          # local dev
# MOLLY_RELAY_URL=http://localhost:8080               # local dev
# MOLLY_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Web setup wizard URL
# MOLLY_WEB_SETUP_URL=http://localhost:3000           # local dev
# MOLLY_WEB_SETUP_URL=https://molly.ploglabs.com     # production (default)
